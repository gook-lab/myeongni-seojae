{
  "name": "myeongri-seojae",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "명리서재 — 대운 인생 타임라인",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "pnpm typecheck && pnpm build && vitest run && playwright test",
    "golden:gen": "tsx scripts/gen-golden.ts",
    "gate": "pnpm typecheck && pnpm build:mcp && vitest run",
    "mcp": "tsx src/mcp/index.ts",
    "build:mcp": "vite build -c vite.mcp.config.ts",
    "verify:kasi": "tsx scripts/verify-kasi.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sentry/react": "^10.70.0",
    "lunar-javascript": "^1.7.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "astronomy-engine": "^2.1.19",
    "korean-lunar-calendar": "^0.4.0",
    "manseryeok": "^2.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "bin": {
    "myeongri-seojae-mcp": "dist-mcp/server.js"
  }
}
